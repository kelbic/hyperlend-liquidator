# Copy to ~/.hyperlend-bot/env (chmod 600) and fill in. NEVER commit a filled copy.
# Code defaults are SAFE (DRY_RUN=1). The executor only sends when DRY_RUN=0 AND HL_CONTRACT set.

# --- required for live ---
HL_CONTRACT=                 # HyperLendLiquidator address from bot/deploy.sh
# Key: prefer a 600-perm file at ~/.hyperlend-bot/key (HL_KEYFILE) over inline.
# HL_PRIVATE_KEY=0x...        # avoid — leaks into process env / shell history
HL_KEYFILE=/home/claude-agent/.hyperlend-bot/key

# --- safety (start here) ---
DRY_RUN=1                    # 1 = log only (default). Flip to 0 ONLY when ready to go live.
HL_MIN_PROFIT=25             # off-chain net floor (USD) AND on-chain minProfit gate (debt-asset)
HL_MIN_DEBT_USD=500          # ignore dust positions
HL_MAX_IMPACT=0.05           # skip a target if the LiquidSwap price impact exceeds this (5%)
HL_MAX_DAILY_GAS_USD=5       # kill-switch (gas is ~$0.007/liq, so this is generous)
HL_MAX_CONSEC_REVERTS=3      # kill-switch
HL_DEDUP_SEC=60              # don't re-fire the same borrower within 60s

# --- path ---
HL_USE_FLASHLOAN=1           # 1 = zero-capital flash loan (default). 0 = spend contract's own
                             #     debt-asset balance (operator pre-funds; no 0.04% premium).

# --- discovery ---
HL_INCR_WINDOW=20000         # per-pass fresh-Borrow getLogs window (blocks back from head)
HL_LOG_CHUNK=4000            # getLogs chunk. drpc HTTP-400s ranges >~8-9k (the chunker halves on
                             #   error, so this is safe/correct). 8000 is the fastest safe value.
# FIRST RUN (recommended): backfill the FULL borrower book once, then it persists (data/book.json).
# Without this, a cold start only sees borrowers active in the last HL_INCR_WINDOW blocks (~5.5h),
# so older near-edge positions are missed until they act again. ~39M blocks / chunk requests, run once:
#   HL_DEPLOY_BLOCK=779363 HL_LOG_CHUNK=8000 python3 -u -m analysis.monitor
# HL_DEPLOY_BLOCK=779363     # Pool proxy deploy block (verified). Leave unset after the backfill.
HL_WATCH_HF=1.10             # read per-asset reserves for borrowers below this HF
HL_REPORT_HF=1.15            # risk-table cutoff

# --- infra ---
HL_RPC=https://rpc.hyperliquid.xyz/evm                  # write endpoint (sign+broadcast)
HL_READ_RPCS=https://hyperliquid.drpc.org,https://rpc.hyperliquid.xyz/evm,https://rpc.hyperlend.finance
HL_POLL_SEC=3                # base cadence (calm)
HL_HOT_POLL_SEC=1            # cadence when near-edge targets exist
HL_GAS_LIMIT=2500000         # HARD gas limit — do NOT trust eth_estimateGas on the callback path
HL_PRIORITY_GWEI=0           # HyperEVM priority fee is NON-OPERATIVE (latency-FCFS, no auction)
HL_HYPE_USD=45               # rough HYPE price for the gas-USD kill-switch only
HL_RAW_TX=0                  # 0 = cast (default, no python deps); 1 = in-process eth_account

# --- alerts (quiet cadence: fires/reverts/kill-switch only; heartbeat OFF) ---
HL_CHAT_ID=265715923         # telegram chat for alerts
HL_HEARTBEAT_SEC=0           # 0 = no heartbeat spam (per the quiet-cadence memo)
